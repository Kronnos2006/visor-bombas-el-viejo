GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
PORT=8766
# Bóveda local opcional. Los lanzadores detectan Vacatos junto al visor.
OBSIDIAN_VAULT=
# Solo Vercel: contraseña para abrir el visor publicado. Vacía = sitio abierto.
VISOR_PASSWORD=

# Mantenimiento Supabase: solo scripts locales/servidor, nunca frontend.
# La conexion MCP de Codex no proporciona estas credenciales a Node ni a Actions.
SUPABASE_ACCESS_TOKEN=
# Sesion temporal de un integrante autorizado para descargar archivos privados:
SUPABASE_STORAGE_TOKEN=
# Alternativa de servidor para respaldos desatendidos (privilegio elevado):
SUPABASE_SECRET_KEY=
